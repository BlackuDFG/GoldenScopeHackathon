@dataclass
class Report:
    id: int
    category: str
    subcategory: str
    damage_severity: float
    traffic_impact: float
    infrastructure_importance: float
    time_urgency: float
    citizen_reports: float  # normalized 0-100, NOT a raw report count
    confidence: float = 1.0
    safety_risk: Optional[float] = None
    risk_types: list[str] = field(default_factory=list)
    critical_hazard_verified: bool = False
    admin_priority: Optional[str] = None
    admin_reason: Optional[str] = None
    status: str = 'REPORTED'
    audit_log: list[dict] = field(default_factory=list)


def classify(report: Report) -> dict:
    if report.category not in TAXONOMY:
        return {'department':'Municipal Triage', 'risk_types':list(report.risk_types),
                'baseline_safety':50, 'requires_review':True, 'unknown':True}
    item = TAXONOMY[report.category]
    if report.subcategory not in item['subcategories']:
        return {'department':item['department'], 'risk_types':list(report.risk_types),
                'baseline_safety':50, 'requires_review':True, 'unknown':True}
    risks, baseline, review = item['subcategories'][report.subcategory]
    unknown_risks = set(report.risk_types) - set(RISK_TYPES)
    if unknown_risks:
        raise ValueError(f'Unknown risk types: {sorted(unknown_risks)}')
    return {'department':item['department'], 'risk_types':sorted(set(risks) | set(report.risk_types)),
            'baseline_safety':baseline, 'requires_review':review, 'unknown':False}


def score_report(report: Report) -> dict:
    info = classify(report)
    if not 0 <= report.confidence <= 1:
        raise ValueError('confidence must be between 0 and 1')
    safety = info['baseline_safety'] if report.safety_risk is None else report.safety_risk
    features = {'safety_risk':safety, 'damage_severity':report.damage_severity,
                'traffic_impact':report.traffic_impact,
                'infrastructure_importance':report.infrastructure_importance,
                'time_urgency':report.time_urgency, 'citizen_reports':report.citizen_reports}
    for key, value in features.items():
        if not 0 <= value <= 100:
            raise ValueError(f'{key} must be between 0 and 100')
    score = sum(features[k] * weight for k, weight in WEIGHTS.items())
    if report.critical_hazard_verified:
        score = max(score, 90)
    score = round(score, 1)
    ai_priority = ('CRITICAL' if score >= 85 else 'HIGH' if score >= 65
                   else 'MEDIUM' if score >= 40 else 'LOW')
    if report.admin_priority is not None and report.admin_priority not in LEVELS:
        raise ValueError('Invalid administrative priority')
    return {'id':report.id, 'category':report.category, 'subcategory':report.subcategory,
            'department':info['department'], 'risk_types':info['risk_types'],
            'priority_score':score, 'ai_priority':ai_priority,
            'effective_priority':report.admin_priority or ai_priority,
            'admin_reason':report.admin_reason, 'status':report.status,
            'requires_human_review':info['requires_review'] or info['unknown'] or report.confidence < .75,
            'critical_hazard_verified':report.critical_hazard_verified,
            'classification_confidence':report.confidence}


def set_admin_priority(report: Report, level: str, reason: str, actor: str) -> None:
    """Call only after checking actor authorization in the application layer."""
    if level not in LEVELS or not reason.strip() or not actor.strip():
        raise ValueError('Valid level, reason and actor required')
    previous = report.admin_priority
    report.admin_priority, report.admin_reason = level, reason
    report.audit_log.append({'timestamp':datetime.now(timezone.utc).isoformat(),
                             'actor':actor, 'previous':previous, 'new':level, 'reason':reason})


def rank_reports(reports: list[Report]) -> list[dict]:
    order = {level:i for i,level in enumerate(LEVELS)}
    results = [score_report(r) for r in reports if r.status != 'COMPLETED']
    return sorted(results, key=lambda r:(order[r['effective_priority']],
                                         -r['priority_score'], r['id']))


def department_lists(reports: list[Report]) -> dict[str, list[dict]]:
    result = {}
    for task in rank_reports(reports):
        result.setdefault(task['department'], []).append(task)
    return result


